{
  "name": "user-portal-server",
  "version": "1.0.0",
  "private": true,
  "description": "Dummy REST API for the User Portal SPA (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dynamo:local": "dynalite --port 8000 --path data/dynamo-local"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "dynalite": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}