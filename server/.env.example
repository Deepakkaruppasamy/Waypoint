# Copy this file to ".env" and change what you need. Every value is optional.

# Port the API listens on
PORT=3000

# Where data is stored:
#   xml     local XML file  (default, no setup)
#   json    local JSON file (no setup)
#   mongo   MongoDB
#   dynamo  AWS DynamoDB
STORAGE=xml

# Only used when STORAGE=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=user_portal

# Only used when STORAGE=dynamo
# Tables "<prefix>-users" and "<prefix>-records" are created automatically.
AWS_REGION=ap-south-1
DYNAMO_TABLE_PREFIX=waypoint
# Real AWS: provide credentials the usual way, for example
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
# Local emulator (npm run dynamo:local): uncomment the next line, no AWS account needed
# DYNAMO_ENDPOINT=http://localhost:8000

# Secret used to sign login tokens. Change it for anything beyond a demo.
JWT_SECRET=change-me-in-real-deployments
JWT_EXPIRES_IN=2h

# Upper limit for the ?delay= query parameter, in milliseconds
MAX_DELAY_MS=10000
